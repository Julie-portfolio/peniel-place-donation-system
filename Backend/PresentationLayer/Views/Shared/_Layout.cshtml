@{
    var isLeader = User.IsInRole("Leadership");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string? Cur(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "page" : null;
    string? CurAction(string ctrl, string act) => controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase) && action.Equals(act, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    var displayName = User.Identity?.Name ?? "Signed in";
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1e4d7b" />
    <title>@ViewData["Title"] - Peniel Place Ministries</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
    <symbol id="i-people" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.2a3.2 3.2 0 010 5.6M18 14.4c1.8.8 3 2.6 3 5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></symbol>
</svg>

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <span class="brand"><span class="brand-mark" aria-hidden="true"></span>Peniel Place</span>
    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
        <button type="submit" class="btn btn-quiet btn-sm">Sign out</button>
    </form>
</header>

<aside class="sidebar" aria-label="Main">
    <div class="brand"><span class="brand-mark" aria-hidden="true"></span>Peniel Place<small>Ministries</small></div>
    <nav>
        <a asp-controller="Donation" asp-action="Create" aria-current="@CurAction("Donation", "Create")"><svg><use href="#i-plus"/></svg>Record donation</a>
        <a asp-controller="Donor" asp-action="Index" aria-current="@Cur("Donor")"><svg><use href="#i-people"/></svg>Donors</a>
        <a asp-controller="Donation" asp-action="Index" aria-current="@CurAction("Donation", "Index")"><svg><use href="#i-doc"/></svg>Donations</a>
        @if (isLeader)
        {
            <a asp-controller="Dashboard" asp-action="Index" aria-current="@Cur("Dashboard")"><svg><use href="#i-chart"/></svg>Dashboard</a>
            <a asp-controller="Report" asp-action="Index" aria-current="@Cur("Report")"><svg><use href="#i-doc"/></svg>Reports</a>
            <a asp-controller="Account" asp-action="CreateVolunteer" aria-current="@CurAction("Account", "CreateVolunteer")"><svg><use href="#i-people"/></svg>Add volunteer</a>
        }
    </nav>
    <div class="sidebar-user">
        <span class="who">@displayName</span>
        <span class="role">@(isLeader ? "Leadership" : "Volunteer")</span>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-quiet btn-sm">Sign out</button>
        </form>
    </div>
</aside>

<main id="main" class="main" tabindex="-1">
    @RenderBody()
</main>

<nav class="tabbar" aria-label="Main">
    <a asp-controller="Donation" asp-action="Create" aria-current="@CurAction("Donation", "Create")"><svg><use href="#i-plus"/></svg><span>Record</span></a>
    <a asp-controller="Donor" asp-action="Index" aria-current="@Cur("Donor")"><svg><use href="#i-people"/></svg><span>Donors</span></a>
    <a asp-controller="Donation" asp-action="Index" aria-current="@CurAction("Donation", "Index")"><svg><use href="#i-doc"/></svg><span>Gifts</span></a>
    @if (isLeader)
    {
        <a asp-controller="Dashboard" asp-action="Index" aria-current="@Cur("Dashboard")"><svg><use href="#i-chart"/></svg><span>Dashboard</span></a>
        <a asp-controller="Report" asp-action="Index" aria-current="@Cur("Report")"><svg><use href="#i-doc"/></svg><span>Reports</span></a>
    }
</nav>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
