@model DonationListViewModel
@{
    ViewData["Title"] = "Donations";
}
<header class="page-head row">
    <div>
        <h1>Donations</h1>
        <p class="lead">Every recorded gift, newest first. Open a receipt to print it again.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Record donation</a>
</header>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="field"><label asp-for="From">From</label><input asp-for="From" type="date" /></div>
    <div class="field"><label asp-for="To">To</label><input asp-for="To" type="date" /></div>
    <div class="field">
        <label asp-for="CategoryId">Type of gift</label>
        <select asp-for="CategoryId">
            <option value="">All types</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label asp-for="DonorId">Donor</label>
        <select asp-for="DonorId">
            <option value="">All donors</option>
            @foreach (var d in Model.Donors)
            {
                <option value="@d.Id" selected="@(Model.DonorId == d.Id)">@d.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
</form>

@if (Model.Rows.Count == 0)
{
    <div class="empty">
        <h2>No donations found</h2>
        <p>Try a wider date range or clear the filters, or record a donation to get started.</p>
        <a asp-action="Create" class="btn btn-primary">Record a donation</a>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Date</th><th>Donor</th><th>Type</th><th class="num">Gift</th><th>Receipt</th>@if (User.IsInRole(Roles.Leadership)) { <th></th> }</tr>
        </thead>
        <tbody>
        @foreach (var d in Model.Rows)
        {
            <tr class="@(d.IsVoided ? "is-void" : null)">
                <td data-label="Date">@Fmt.Date(d.Date)</td>
                <td data-label="Donor">
                    @if (d.DonorId is int did)
                    {
                        <a asp-controller="Donor" asp-action="Details" asp-route-id="@did">@d.DonorName</a>
                    }
                    else
                    {
                        <span class="muted">@d.DonorName</span>
                    }
                </td>
                <td data-label="Type">@d.CategoryName</td>
                <td data-label="Gift" class="num">@(d.IsInKind ? d.InKindDescription : Fmt.Money(d.Amount))</td>
                <td data-label="Receipt">
                    @if (d.ReceiptId is int rid)
                    {
                        <a asp-controller="Receipt" asp-action="Details" asp-route-id="@rid">@d.ReceiptNumber</a>
                    }
                    else { <span class="muted">Not issued</span> }
                    @if (d.IsVoided) { <span class="badge-void">VOID</span> }
                </td>
                @if (User.IsInRole(Roles.Leadership))
                {
                    <td data-label="">
                        @if (!d.IsVoided)
                        {
                            <a asp-action="Void" asp-route-id="@d.DonationId" class="muted small">Void</a>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Truncated)
    {
        <p class="muted small">Showing the latest @Model.Rows.Count gifts. Narrow the dates or filters to see older ones.</p>
    }
}
